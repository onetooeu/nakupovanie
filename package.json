{
  "name": "nakupovanie-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI-native digital commerce and comparison platform for Slovakia and Czechia.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "4.1.10"
  }
}
